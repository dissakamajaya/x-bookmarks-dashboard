# Server
PORT=8787

# X API auth
# OAuth 2.0 user access token for your own account.
X_ACCESS_TOKEN=

# Optional fallbacks if /2/users/me is not available for the token.
# Set one of these if the dashboard cannot resolve the authenticated user automatically.
X_USER_ID=
X_USERNAME=

# Optional API host override.
# Default: https://api.x.com
# Fallback: https://api.twitter.com
X_API_BASE_URL=https://api.x.com

# Optional tuning
BOOKMARK_LIMIT=50
CACHE_TTL_MS=15000
